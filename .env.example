PORT=8080

# Chave exigida no header x-api-key. Deixe vazio só enquanto ainda existir
# cliente antigo sem a chave (icms-ro da Vercel).
API_KEY=

# CNPJ usado quando o cliente não manda "cnpj" (compatibilidade com o icms-ro antigo).
DEFAULT_CNPJ=46397430000190
DEFAULT_CODIGO_RECEITA=1414

# Emissões em paralelo. A VPS tem 2 vCPUs; mais que 2 deixa tudo lento.
MAX_CONCURRENCY=2
# Fecha e reabre o Chrome a cada N emissões para não acumular memória.
BROWSER_RECYCLE_AFTER=100
PAGE_TIMEOUT_MS=45000

# Só para rodar fora do Docker com o Chrome visível.
# HEADLESS=false
# CHROME_PATH=

# Emissor de DAR da SEFAZ-MT (FETHAB). É lento: o timeout vale para cada etapa.
# SEFAZ_MT_URL=https://www.sefaz.mt.gov.br/arrecadacao/darlivre
SEFAZ_MT_TIMEOUT_MS=90000
